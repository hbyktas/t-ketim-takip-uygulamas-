<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bütçe Takip Uygulaması</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fb;
        }
        /* Özel kaydırma çubuğu stili */
        #transaction-list::-webkit-scrollbar {
            width: 4px;
        }
        #transaction-list::-webkit-scrollbar-thumb {
            background-color: #a0aec0;
            border-radius: 2px;
        }
    </style>
</head>
<body class="min-h-screen p-4 sm:p-6 flex items-center justify-center">

    <div id="app-container" class="w-full max-w-lg bg-white shadow-xl rounded-2xl p-6 sm:p-8">
        <!-- Uygulama Başlığı -->
        <h1 class="text-3xl font-extrabold text-gray-800 mb-6 flex items-center">
            <img id="app-logo" src="https://i.hizliresim.com/2z6du75.png" onerror="this.onerror=null;this.src='https://placehold.co/40x40/5c6bc0/ffffff?text=LOGO'" alt="Uygulama Logosu" class="w-10 h-10 mr-3 rounded-lg" />
            Bütçe Takip
        </h1>
        <p class="text-sm text-gray-500 mb-6">Merhaba! Gelir ve giderlerinizi buraya kaydedin. Verileriniz size özel olarak kaydedilecektir.</p>

        <!-- Bakiye Özeti -->
        <div class="bg-indigo-600 text-white p-5 rounded-xl shadow-lg mb-6">
            <div class="flex justify-between items-center">
                <div>
                    <span class="text-sm font-medium opacity-80">Toplam Bakiye</span>
                    <p id="current-balance" class="text-4xl font-bold mt-1">0.00 ₺</p>
                </div>
                <i data-lucide="trending-up" class="w-10 h-10 opacity-70"></i>
            </div>
        </div>

        <!-- Yeni İşlem Formu -->
        <div class="bg-gray-50 p-5 rounded-xl mb-6">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Yeni İşlem Ekle</h2>
            <div id="auth-status" class="text-xs text-red-500 mb-3 hidden">
                Kullanıcı kimliği yükleniyor...
            </div>
            <div class="flex flex-col space-y-4">
                <input type="text" id="description-input" placeholder="Açıklama (Örn: Maaş, Kira)"
                       class="p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-150"
                       maxlength="50">

                <input type="number" id="amount-input" placeholder="Tutar (Örn: 500.00)"
                       class="p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-150"
                       min="0.01" step="0.01">

                <div class="flex space-x-3">
                    <button id="add-income-btn" data-type="income"
                            class="flex-1 py-3 px-4 bg-green-500 text-white font-semibold rounded-lg shadow-md hover:bg-green-600 transition duration-200 flex items-center justify-center">
                        <i data-lucide="plus-circle" class="w-5 h-5 mr-2"></i> Gelir Ekle
                    </button>
                    <button id="add-expense-btn" data-type="expense"
                            class="flex-1 py-3 px-4 bg-red-500 text-white font-semibold rounded-lg shadow-md hover:bg-red-600 transition duration-200 flex items-center justify-center">
                        <i data-lucide="minus-circle" class="w-5 h-5 mr-2"></i> Gider Ekle
                    </button>
                </div>
            </div>
            <p id="error-message" class="text-red-500 text-sm mt-3 hidden">Lütfen geçerli bir açıklama ve pozitif bir tutar girin.</p>
        </div>
        
        <!-- Ay Seçimi Filtresi -->
        <div class="mb-4 flex justify-between items-center">
            <h2 class="text-xl font-semibold text-gray-700 flex items-center">
                <i data-lucide="list-ordered" class="w-5 h-5 mr-2 text-indigo-500"></i>
                İşlemler
            </h2>
            <select id="month-select" class="p-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 text-sm">
                <!-- Seçenekler JS ile doldurulacak -->
            </select>
        </div>

        <!-- İşlemler Listesi -->
        <div id="transaction-list-container" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <ul id="transaction-list" class="space-y-1 max-h-80 overflow-y-auto p-1">
                <!-- İşlemler buraya JS ile eklenecek -->
                <li id="loading-indicator" class="p-4 text-center text-gray-500">İşlemler yükleniyor...</li>
            </ul>
        </div>
        <p id="empty-list-message" class="text-center text-gray-500 mt-4 hidden">Seçili ay için henüz bir işlem eklemediniz.</p>
        
        <!-- Kullanıcı Kimliği -->
        <p class="mt-6 text-xs text-gray-400">
            Kullanıcı Kimliğiniz: <span id="user-id-display" class="font-mono text-gray-600 break-all">Yükleniyor...</span>
        </p>

    </div>

    <!-- Firebase SDK'ları -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged, setPersistence, browserLocalPersistence } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, addDoc, setDoc, updateDoc, deleteDoc, onSnapshot, collection, query, where, orderBy, serverTimestamp, setLogLevel } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        
        // Firebase logging level set to debug for easier troubleshooting
        setLogLevel('debug');

        // Securely retrieving global variables from the Canvas environment
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        let app, db, auth, userId = null;
        let isAuthReady = false;
        
        // State for tracking the currently selected month (initially current month)
        // Store as a date object representing the first day of the month
        let currentFilterDate = new Date(); 
        
        const descriptionInput = document.getElementById('description-input');
        const amountInput = document.getElementById('amount-input');
        const addIncomeBtn = document.getElementById('add-income-btn');
        const addExpenseBtn = document.getElementById('add-expense-btn');
        const transactionList = document.getElementById('transaction-list');
        const currentBalanceDisplay = document.getElementById('current-balance');
        const errorMsg = document.getElementById('error-message');
        const loadingIndicator = document.getElementById('loading-indicator');
        const emptyListMsg = document.getElementById('empty-list-message');
        const userIdDisplay = document.getElementById('user-id-display');
        const authStatus = document.getElementById('auth-status');
        const monthSelect = document.getElementById('month-select');

        // --- Date Utility Functions ---

        // Returns a date object set to the first millisecond of the month
        function getStartOfMonth(date) {
            const start = new Date(date.getFullYear(), date.getMonth(), 1);
            start.setHours(0, 0, 0, 0);
            return start;
        }

        // Returns a date object set to the last millisecond of the month
        function getEndOfMonth(date) {
            const end = new Date(date.getFullYear(), date.getMonth() + 1, 0);
            end.setHours(23, 59, 59, 999);
            return end;
        }

        // Formats the month/year for the selector display
        function formatMonthYear(date) {
            const options = { year: 'numeric', month: 'long' };
            return date.toLocaleDateString('tr-TR', options);
        }

        // --- UI and State Management ---

        // Simulates a message box for errors/success
        function showMessage(text, isError = false) {
            errorMsg.textContent = text;
            errorMsg.className = isError 
                ? 'text-red-500 text-sm mt-3 block' 
                : 'text-green-500 text-sm mt-3 block';
            if (!isError) {
                setTimeout(() => errorMsg.classList.add('hidden'), 3000);
            }
        }
        
        // Populates the month selection dropdown with the last 12 months
        function populateMonthSelector() {
            monthSelect.innerHTML = '';
            const today = new Date();
            const currentMonthKey = `${today.getFullYear()}-${today.getMonth()}`;

            for (let i = 0; i < 12; i++) { // Show last 12 months
                const date = new Date(today.getFullYear(), today.getMonth() - i, 1);
                const year = date.getFullYear();
                const month = date.getMonth();
                const optionText = formatMonthYear(date);
                const optionValue = `${year}-${month}`;

                const option = document.createElement('option');
                option.value = optionValue;
                option.textContent = optionText;
                
                // Select the current month by default
                if (optionValue === currentMonthKey) {
                    option.selected = true;
                }

                monthSelect.appendChild(option);
            }

            monthSelect.addEventListener('change', (event) => {
                const [year, month] = event.target.value.split('-').map(Number);
                currentFilterDate = new Date(year, month, 1);
                // Re-setup listener to filter new month's data
                setupRealtimeListener();
            });
        }
        
        // --- Firebase Functions ---

        // Firebase and Authentication Initialization
        async function initializeFirebase() {
            if (!firebaseConfig) {
                console.error("Firebase configuration not found.");
                authStatus.textContent = 'HATA: Firebase yapılandırması eksik.';
                authStatus.classList.remove('hidden');
                return;
            }

            try {
                app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);
                
                await setPersistence(auth, browserLocalPersistence);

                authStatus.textContent = 'Kimlik doğrulanıyor...';
                authStatus.classList.remove('hidden');

                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        userId = user.uid;
                        userIdDisplay.textContent = userId;
                        isAuthReady = true;
                        authStatus.classList.add('hidden');
                        console.log("Kullanıcı kimliği doğrulandı:", userId);
                        populateMonthSelector(); // Populate selector after auth
                        setupRealtimeListener(); // Start listening
                    } else {
                        userId = null;
                        userIdDisplay.textContent = "Anonim Kullanıcı";
                        isAuthReady = true;
                        authStatus.textContent = 'Kullanıcı anonim olarak doğrulandı.';
                        authStatus.classList.remove('hidden');
                    }
                });

            } catch (error) {
                console.error("Firebase initialization/authentication error:", error);
                authStatus.textContent = `Kimlik Doğrulama Hatası: ${error.message}`;
                authStatus.classList.remove('hidden');
            }
        }

        // Returns the collection reference for transactions
        function getTransactionCollectionRef() {
            if (!db || !userId) return null;
            // Private data path: /artifacts/{appId}/users/{userId}/{collectionName}
            const path = `artifacts/${appId}/users/${userId}/transactions`;
            return collection(db, path);
        }

        // Real-time listener for transactions, now filtered by month
        function setupRealtimeListener() {
            if (!isAuthReady || !userId) return;

            const transactionsRef = getTransactionCollectionRef();
            if (!transactionsRef) return;
            
            // Calculate start and end date for the selected month filter
            const startDate = getStartOfMonth(currentFilterDate);
            const endDate = getEndOfMonth(currentFilterDate);

            // Firestore query: Filter by timestamp range and order by timestamp (newest first)
            const q = query(
                transactionsRef, 
                where("timestamp", ">=", startDate),
                where("timestamp", "<=", endDate),
                orderBy("timestamp", "desc")
            );

            loadingIndicator.classList.remove('hidden');
            transactionList.innerHTML = ''; 

            onSnapshot(q, (snapshot) => {
                loadingIndicator.classList.add('hidden');
                
                const transactions = [];
                snapshot.forEach((doc) => {
                    // Firestore timestamp objects need to be converted to Date for display/manipulation
                    transactions.push({ id: doc.id, ...doc.data() });
                });

                renderTransactions(transactions);
                calculateBalance(transactions);

            }, (error) => {
                console.error("Error listening to transactions:", error);
                showMessage("İşlemleri yüklerken bir hata oluştu.", true);
            });
        }

        // Calculates the total balance for the displayed transactions
        function calculateBalance(transactions) {
            const totalBalance = transactions.reduce((acc, transaction) => {
                const amount = parseFloat(transaction.amount || 0);
                if (transaction.type === 'income') {
                    return acc + amount;
                } else if (transaction.type === 'expense') {
                    return acc - amount;
                }
                return acc;
            }, 0);

            currentBalanceDisplay.textContent = `${totalBalance.toFixed(2)} ₺`;
            currentBalanceDisplay.classList.toggle('text-red-400', totalBalance < 0);
            currentBalanceDisplay.classList.toggle('text-white', totalBalance >= 0);
        }

        // Renders the transactions list
        function renderTransactions(transactions) {
            transactionList.innerHTML = ''; 

            if (transactions.length === 0) {
                emptyListMsg.classList.remove('hidden');
                return;
            }
            emptyListMsg.classList.add('hidden');

            transactions.forEach(transaction => {
                const isIncome = transaction.type === 'income';
                const sign = isIncome ? '+' : '-';
                const colorClass = isIncome ? 'text-green-600 bg-green-50' : 'text-red-600 bg-red-50';
                const icon = isIncome ? 'trending-up' : 'trending-down';
                
                // Safely get timestamp and format the date
                const date = transaction.timestamp ? new Date(transaction.timestamp.toDate()) : new Date();
                const dateString = date.toLocaleDateString('tr-TR');

                const listItem = document.createElement('li');
                listItem.className = `p-3 flex items-center justify-between border-b border-gray-100 last:border-b-0 hover:bg-gray-50 transition duration-150`;
                listItem.dataset.id = transaction.id;

                const amountText = `${sign} ${parseFloat(transaction.amount).toFixed(2)} ₺`;

                listItem.innerHTML = `
                    <div class="flex items-center flex-1 min-w-0">
                        <div class="p-2 mr-3 rounded-full ${colorClass}">
                            <i data-lucide="${icon}" class="w-5 h-5"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-gray-800 font-medium truncate">${transaction.description}</p>
                            <p class="text-xs text-gray-400 mt-0.5">${dateString}</p>
                        </div>
                    </div>
                    <div class="text-lg font-semibold ${isIncome ? 'text-green-600' : 'text-red-600'} flex items-center ml-2">
                        ${amountText}
                        <button class="delete-btn ml-3 p-1 rounded-full text-gray-400 hover:text-red-500 transition duration-150" data-id="${transaction.id}">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
                transactionList.appendChild(listItem);
            });
            lucide.createIcons(); 

            document.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', handleDeleteTransaction);
            });
        }
        
        // Handles adding a new transaction
        async function handleAddTransaction(event) {
            if (!db || !userId) {
                showMessage("Uygulama henüz hazır değil, lütfen bekleyin.", true);
                return;
            }

            const type = event.currentTarget.dataset.type; 
            const description = descriptionInput.value.trim();
            const amount = parseFloat(amountInput.value);

            if (!description || isNaN(amount) || amount <= 0) {
                showMessage("Lütfen geçerli bir açıklama ve pozitif bir tutar girin.", true);
                return;
            }
            
            errorMsg.classList.add('hidden'); 
            
            try {
                const transactionData = {
                    description,
                    amount: amount.toFixed(2),
                    type,
                    timestamp: serverTimestamp() 
                };

                const transactionsRef = getTransactionCollectionRef();
                await addDoc(transactionsRef, transactionData);

                descriptionInput.value = '';
                amountInput.value = '';
                showMessage(`${type === 'income' ? 'Gelir' : 'Gider'} başarıyla eklendi!`);

            } catch (e) {
                console.error("Error adding transaction:", e);
                showMessage("İşlem eklenirken bir hata oluştu. Tekrar deneyin.", true);
            }
        }

        // Handles deleting a transaction
        async function handleDeleteTransaction(event) {
            if (!db || !userId) return;

            const transactionId = event.currentTarget.dataset.id;
            
            console.log(`Deleting transaction: ${transactionId}`);

            try {
                const transactionsRef = getTransactionCollectionRef();
                const transactionDocRef = doc(transactionsRef, transactionId);
                await deleteDoc(transactionDocRef);
                showMessage("İşlem başarıyla silindi.", false);

            } catch (e) {
                console.error("Error deleting transaction:", e);
                showMessage("İşlem silinirken bir hata oluştu. Tekrar deneyin.", true);
            }
        }


        // Event listeners
        addIncomeBtn.addEventListener('click', handleAddTransaction);
        addExpenseBtn.addEventListener('click', handleAddTransaction);

        // Start the application
        initializeFirebase();
        
        // Initialize Lucide icons
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });

    </script>
</body>
</html>

